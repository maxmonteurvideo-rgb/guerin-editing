# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# originaux vidéo non compressés — seules les versions compressées vont en ligne
# (Windows ignore la casse : on cible les noms avec espace + les originaux nommés)
/public/videos/* *.mp4
/public/videos/YOMI.mp4
/public/videos/VSL.mp4
# ancienne version erronée de l'extrait Manael (contenait la vidéo de Baptiste)
/public/videos/vsl-manael.mp4
/public/videos/vsl-manael.jpg
